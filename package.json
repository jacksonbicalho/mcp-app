{
  "name": "mcp-app",
  "version": "1.0.0",
  "private": true,
  "description": "MCP Server for analyzing the App system and its PostgreSQL database",
  "main": "dist/main.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "start:dev": "ts-node src/main.ts",
    "start:debug": "ts-node --inspect src/main.ts",
    "watch": "tsc -w",
    "clean": "rm -rf dist",
    "rebuild": "yarn clean && yarn build",
    "lint": "eslint \"src/**/*.ts\" \"scripts/**/*.ts\" \"jest.config.ts\" \"jest.setup.ts\"",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "kill-mcp": "pkill -fe '^node .*dist/main\\.js' || true",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "keywords": [
    "mcp",
    "app",
    "nestjs",
    "postgresql",
    "analyzer"
  ],
  "author": "Jackson Bicalho",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.2",
    "@nestjs/common": "^11.1.11",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.11",
    "@nestjs/platform-express": "^11.1.11",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "nestjs-pino": "^3.0.0",
    "pg": "^8.16.3",
    "pino": "^9.0.0",
    "pino-http": "^8.0.0",
    "pino-multi-stream": "^6.0.0",
    "pino-pretty": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.14",
    "@nestjs/testing": "^11.2.5",
    "@types/jest": "30.0.0",
    "@types/node": "^22.19.6",
    "@types/pg": "^8.16.0",
    "@types/pino-multi-stream": "^5.1.6",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "30.5.1",
    "jest-fetch-mock": "^4.2.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.6",
    "ts-jest": "29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
